# Dissolution-only kinetic laws for primary evaporites. PARM(2) is the
# formation-brine reference saturation ratio. Rates activate only when mixing
# with channel water lowers SR below that initial metastable state; this avoids
# attributing domain-wide background re-equilibration to recharge. These
# reference values are case calibration parameters, not universal constants.
RATES
Halite
    -start
    10 rate = 0
    20 IF M <= 0 THEN GOTO 100
    30 affinity = 1 - SR("Halite") / PARM(2)
    40 IF affinity < 0 THEN affinity = 0
    50 rate = PARM(1) * M * affinity
    100 SAVE rate * TIME
    -end
Carnallite
    -start
    10 rate = 0
    20 IF M <= 0 THEN GOTO 100
    30 affinity = 1 - SR("Carnallite") / PARM(2)
    40 IF affinity < 0 THEN affinity = 0
    50 rate = PARM(1) * M * affinity
    100 SAVE rate * TIME
    -end
Polyhalite
    -start
    10 rate = 0
    20 IF M <= 0 THEN GOTO 100
    30 affinity = 1 - SR("Polyhalite") / PARM(2)
    40 IF affinity < 0 THEN affinity = 0
    50 rate = PARM(1) * M * affinity
    100 SAVE rate * TIME
    -end
Sylvite
    -start
    10 rate = 0
    20 IF M <= 0 THEN GOTO 100
    30 affinity = 1 - SR("Sylvite") / PARM(2)
    40 IF affinity < 0 THEN affinity = 0
    50 rate = PARM(1) * M * affinity
    100 SAVE rate * TIME
    -end
Gypsum
    -start
    10 rate = 0
    20 IF M <= 0 THEN GOTO 100
    30 affinity = 1 - SR("Gypsum") / PARM(2)
    40 IF affinity < 0 THEN affinity = 0
    50 rate = PARM(1) * M * affinity
    100 SAVE rate * TIME
    -end
Borax
    -start
    10 rate = 0
    20 IF M <= 0 THEN GOTO 100
    30 affinity = 1 - SR("Borax") / PARM(2)
    40 IF affinity < 0 THEN affinity = 0
    50 rate = PARM(1) * M * affinity
    100 SAVE rate * TIME
    -end
END

USER_PUNCH 1
    -headings Na K Li Mg Ca Cl S_6 B Br pH ionic_strength exchange_sites Halite Carnallite Polyhalite Sylvite Gypsum Borax d_Halite d_Carnallite d_Polyhalite d_Sylvite d_Gypsum d_Borax Bischofite Syngenite Mirabilite d_Bischofite d_Syngenite d_Mirabilite SI_Halite SI_Sylvite SI_Carnallite SI_Polyhalite SI_Gypsum SI_Borax RHO
    -start
    10 conv = TOT("water") / SOLN_VOL
    20 PUNCH TOT("Na") * conv
    30 PUNCH TOT("K") * conv
    40 PUNCH TOT("Li") * conv
    50 PUNCH TOT("Mg") * conv
    60 PUNCH TOT("Ca") * conv
    70 PUNCH TOT("Cl") * conv
    80 PUNCH TOT("S(6)") * conv
    90 PUNCH TOT("B") * conv
    100 PUNCH TOT("Br") * conv
    110 PUNCH -LA("H+")
    120 PUNCH MU
    130 PUNCH TOT("X") * TOT("water")
    140 PUNCH KIN("Halite")
    150 PUNCH KIN("Carnallite")
    160 PUNCH KIN("Polyhalite")
    170 PUNCH KIN("Sylvite")
    180 PUNCH KIN("Gypsum")
    190 PUNCH KIN("Borax")
    200 PUNCH KIN_DELTA("Halite")
    210 PUNCH KIN_DELTA("Carnallite")
    220 PUNCH KIN_DELTA("Polyhalite")
    230 PUNCH KIN_DELTA("Sylvite")
    240 PUNCH KIN_DELTA("Gypsum")
    250 PUNCH KIN_DELTA("Borax")
    260 PUNCH EQUI("Bischofite")
    270 PUNCH EQUI("Syngenite")
    280 PUNCH EQUI("Mirabilite")
    290 PUNCH EQUI_DELTA("Bischofite")
    300 PUNCH EQUI_DELTA("Syngenite")
    310 PUNCH EQUI_DELTA("Mirabilite")
    320 PUNCH SI("Halite")
    330 PUNCH SI("Sylvite")
    340 PUNCH SI("Carnallite")
    350 PUNCH SI("Polyhalite")
    360 PUNCH SI("Gypsum")
    370 PUNCH SI("Borax")
    380 PUNCH RHO
    -end
END

SELECTED_OUTPUT 1
    -reset          false
    -high_precision false
END

KNOBS
    -iterations             250
    -convergence_tolerance  1e-8
    -tolerance              1e-14
    -step_size              10
    -pe_step_size           5
    -diagonal_scale         true
END

PRINT
    -warnings true
END
