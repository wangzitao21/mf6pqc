# Idealized salt-lake brine and recharge-water chemistry.
# Concentrations are mol/kgw in the definitions. MF6PQC/PhreeqcRM converts
# transported component concentrations to mol/L for MODFLOW 6 GWT.

SOLUTION 0 Formation brine
    units     mol/kgw
    temp      25.0
    pH        7.20
    pe        4.0
    Na        4.50
    K         5.00e-2
    Mg        8.00e-1
    Ca        8.00e-2
    Li        2.00e-3
    Cl        6.00 charge
    S(6)      1.50e-1
    B         5.00e-3
    Br        1.00e-6
    -water    1.0
END

# Precondition the formation brine with halite and any secondary evaporites
# that can precipitate from it. Only the aqueous solution is saved; the
# secondary solid inventory begins at zero in the reactive cells below.
EQUILIBRIUM_PHASES 100 Formation-brine preconditioning
    Halite       0.0  100.0
    Bischofite   0.0    0.0
    Syngenite    0.0    0.0
    Mirabilite   0.0    0.0
USE solution 0
USE equilibrium_phases 100
SAVE solution 0
END

SOLUTION 1 Halite-saturated channel water with conservative Br tracer
    units     mol/kgw
    temp      25.0
    pH        7.00
    pe        4.0
    Na        5.80
    K         1.00e-4
    Mg        1.00e-4
    Ca        1.00e-4
    Li        1.00e-6
    Cl        5.80 charge
    S(6)      1.00e-4
    B         1.00e-5
    Br        1.00e-3
    -water    1.0
END

EQUILIBRIUM_PHASES 101 Channel-water halite saturation
    Halite       0.0  100.0
USE solution 1
USE equilibrium_phases 101
SAVE solution 1
END

# Zero initial amounts allow secondary salts to precipitate when reaction
# paths cross their saturation surfaces, but prevent dissolution before they
# have formed.
EQUILIBRIUM_PHASES 1 Secondary evaporites
    Bischofite   0.0  0.0
    Syngenite    0.0  0.0
    Mirabilite   0.0  0.0
END

# A small exchange capacity provides a defensible first-stage Li mechanism:
# high-Na recharge can displace initially sorbed Li/K. A site-specific Li
# mineral should replace or augment this block when field mineralogy is known.
EXCHANGE 1
    X  2.00e-2
    -equilibrate with solution 0
END

# Facies 1: nominal 70-vol% evaporite assemblage, about 2.20 wt% elemental K.
KINETICS 1 Background potash facies
    Halite
        -m0       20.0738007380
        -m        20.0738007380
        -parms     2.00e-8  1.0000000000
        -tol       1.00e-9
    Carnallite
        -m0        0.3454231434
        -m         0.3454231434
        -parms     5.00e-9  1.2059079271e-4
        -tol       1.00e-10
    Polyhalite
        -m0        0.1834862385
        -m         0.1834862385
        -parms     5.00e-10 1.0855774121e-2
        -tol       1.00e-10
    Sylvite
        -m0        0.1333333333
        -m         0.1333333333
        -parms     8.00e-9  2.2741950250e-2
        -tol       1.00e-10
    Gypsum
        -m0        0.6063872793
        -m         0.6063872793
        -parms     1.00e-9  1.0000000000
        -tol       1.00e-10
    Borax
        -m0        0.0269058296
        -m         0.0269058296
        -parms     2.00e-9  3.9680266000e-7
        -tol       1.00e-11
    -cvode       true
    -cvode_steps 300
    -bad_step_max 500
END

