USER_PUNCH 1
    -headings Benz_l Benz_h Tolu_l Tolu_h Ethyl_l Ethyl_h Xyl_l Xyl_h Oxyl_l Oxyl_h Naph_l Naph_h Ace Fluorene Sulf_l_6 Sulf_h_6 Sulfid_l_m2 Sulfid_h_m2 O_0 Ca Mg Na K Fe_2 Fe_3 Cl C_4 N pH pe Benznapl Tolunapl Ethylnapl Xylnapl Oxylnapl Naphnapl Acenapl Flnnapl Sulfred Calcite Goethite Pyrite
    -start
    10 PUNCH TOT("Benz_l") * TOT("water") / SOLN_VOL
    20 PUNCH TOT("Benz_h") * TOT("water") / SOLN_VOL
    30 PUNCH TOT("Tolu_l") * TOT("water") / SOLN_VOL
    40 PUNCH TOT("Tolu_h") * TOT("water") / SOLN_VOL
    50 PUNCH TOT("Ethyl_l") * TOT("water") / SOLN_VOL
    60 PUNCH TOT("Ethyl_h") * TOT("water") / SOLN_VOL
    70 PUNCH TOT("Xyl_l") * TOT("water") / SOLN_VOL
    80 PUNCH TOT("Xyl_h") * TOT("water") / SOLN_VOL
    90 PUNCH TOT("Oxyl_l") * TOT("water") / SOLN_VOL
    100 PUNCH TOT("Oxyl_h") * TOT("water") / SOLN_VOL
    110 PUNCH TOT("Naph_l") * TOT("water") / SOLN_VOL
    120 PUNCH TOT("Naph_h") * TOT("water") / SOLN_VOL
    130 PUNCH TOT("Ace") * TOT("water") / SOLN_VOL
    140 PUNCH TOT("Fluorene") * TOT("water") / SOLN_VOL
    150 PUNCH TOT("Sulf_l(6)") * TOT("water") / SOLN_VOL
    160 PUNCH TOT("Sulf_h(6)") * TOT("water") / SOLN_VOL
    170 PUNCH TOT("Sulfid_l(-2)") * TOT("water") / SOLN_VOL
    180 PUNCH TOT("Sulfid_h(-2)") * TOT("water") / SOLN_VOL
    190 PUNCH TOT("O(0)") * TOT("water") / SOLN_VOL
    200 PUNCH TOT("Ca") * TOT("water") / SOLN_VOL
    210 PUNCH TOT("Mg") * TOT("water") / SOLN_VOL
    220 PUNCH TOT("Na") * TOT("water") / SOLN_VOL
    230 PUNCH TOT("K") * TOT("water") / SOLN_VOL
    240 PUNCH TOT("Fe(2)") * TOT("water") / SOLN_VOL
    250 PUNCH TOT("Fe(3)") * TOT("water") / SOLN_VOL
    260 PUNCH TOT("Cl") * TOT("water") / SOLN_VOL
    270 PUNCH TOT("C(4)") * TOT("water") / SOLN_VOL
    280 PUNCH TOT("N") * TOT("water") / SOLN_VOL
    290 PUNCH -LA("H+")
    300 PUNCH -LA("e-")
    310 PUNCH KIN("Benznapl")
    320 PUNCH KIN("Tolunapl")
    330 PUNCH KIN("Ethylnapl")
    340 PUNCH KIN("Xylnapl")
    350 PUNCH KIN("Oxylnapl")
    360 PUNCH KIN("Naphnapl")
    370 PUNCH KIN("Acenapl")
    380 PUNCH KIN("Flnnapl")
    390 PUNCH KIN("Sulfred")
    # PHT3D reports mineral inventories per litre of bulk aquifer. The
    # PhreeqcRM reaction cell represents one litre of pore water here.
    400 PUNCH EQUI("Calcite") * 0.30
    410 PUNCH EQUI("Goethite") * 0.30
    420 PUNCH EQUI("Pyrite") * 0.30
    -end
END

SELECTED_OUTPUT 1
    -reset false
    -high_precision true
END

PRINT
    -warnings 0
END
