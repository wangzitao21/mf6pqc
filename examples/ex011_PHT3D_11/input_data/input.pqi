    Tolu_l
        -parms 5.0e-4 3.0e-5
        -m0 10
        -formula Tolu_l -1 H2O -2.58 H+ -1.86 HCO3- 6.3
    Tolu_h
        -parms -2.0
        -m0 10
        -formula Tolu_h -1 H2O -2.58 H+ -1.86 HCO3- 6.3
