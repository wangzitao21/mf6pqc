#              ------ // ------

#--------------------------------------------------------
Benz_l # Benzene ligth - Last revised: 12/03/2008
#--------------------------------------------------------
# Input parameters
# Definition of the compound moles 
   20  mBenz_l   = TOT("Benz_l")			# Conc. of lighter compound
   21  mBenz_h   = TOT("Benz_h")			# Conc. of heavier compound
   22  mBenz     = mBenz_l + mBenz_h		# total number of mol for the compound
   23  IF (mBenz < 1e-11) THEN GOTO 200   # If the compound conc. is too low, do not calculate any rates (avoid numerical problems) 
# Definition of electron acceptors moles
   32  mSulf   = TOT("Sulf_l(6)") + TOT("Sulf_h(6)")					# Sulfate moles
   33  mSulfred   = KIN("Sulfred")			      # Sulfate reducers
# Biodegradation rate for sulfate-reducing conditions
   40 v_up_max_Benz = parm(1) #0.00002 
   41 theta_bio_max = parm(2) #0.01000  
   42 inhib_bio = (theta_bio_max-mSulfred)/theta_bio_max
   43 monSulf = mSulf / (0.004 + mSulf)  
   44 if (mSulf < 1.0e-05) then monSulf = 0 
   45 monBenz = mBenz / (0.0001 + mBenz) 
   46 v_up_Benz = v_up_max_Benz*inhib_bio*monBenz*monSulf  
   47 rate_sulf = v_up_Benz*mSulfred
# Molar fraction of lighter isotope 
   70  R = mBenz_l / mBenz		                  
# Save the biodegradation rate for the rate calculation of the heavier part 
   82  put(rate_sulf,24)
   83  rate = rate_sulf	
# Update moles based on the calculated rates			
   90  moles = rate * R * time		                  # update lighter isotope moles based on the biodegradation rate
   91  if (moles > mBenz_l) then moles = mBenz_l      # this is to avoid negative mass
# Save moles
   200 save moles
  -end
#--------------------------------------------------------
Benz_h # Benzene heavy 
#--------------------------------------------------------
-start
# Input parameters
  4  epsilon_sulf  = parm(1)	# Isotope enrichment factor sulfate-reducing conditions	 
# Get concentrations of lighter and heavier fractions + calculate total conc  	
 10  mBenz_l       = TOT("Benz_l")           # Conc. of lighter compound
 11  mBenz_h       = TOT("Benz_h")           # Conc. of heavier compound
 12  mBenz         = mBenz_l + mBenz_h       # total compound conc.
 13  If (mBenz  < 1e-11) THEN GOTO 200     # If the compound conc. is too low, do not calculate any rates (avoid numerical problems)
# Molar fraction of lighter isotope 
 20  R = mBenz_h  / mBenz         
# Calculate the biodegradation rate for heavier isotopes based on the enrichment factor (transformed here to fractionation factor) 
 32  rate_sulf     = get(24) * ((epsilon_sulf/1000)+1)   
 33  rate = rate_sulf
# Update moles based on the calculated rates
 40  moles   = R * rate * time   # update lighter isotope moles based on the biodegradation rate
# Save moles
 200 SAVE moles
-end
#			---------------- // ----------------

#--------------------------------------------------------
Tolu_l # Toluene ligth - Last revised: 12/03/2008
#--------------------------------------------------------
# Input parameters
# Definition of the compound moles
   20  mTolu_l   = TOT("Tolu_l")			# Conc. of lighter compound
   21  mTolu_h   = TOT("Tolu_h")			# Conc. of heavier compound
   22  mTolu     = mTolu_l + mTolu_h		# total number of mol for the compound
   23  IF (mTolu < 1e-11) THEN GOTO 200   # If the compound conc. is too low, do not calculate any rates (avoid numerical problems)
# Definition of electron acceptors moles
   32  mSulf   = TOT("Sulf_l(6)") + TOT("Sulf_h(6)")						# Sulfate moles
   33  mSulfred   = KIN("Sulfred")			      # Sulfate reducers
# Biodegradation rate for sulfate-reducing conditions
   40 v_up_max_Tolu = parm(1) #0.00002
   41 theta_bio_max = parm(2) #0.01000
   42 inhib_bio = (theta_bio_max-mSulfred)/theta_bio_max
   43 monSulf = mSulf / (0.004 + mSulf)
   44 if (mSulf < 1.0e-05) then monSulf = 0 
   45 monTolu = mTolu / (0.0001 + mTolu)
   46 v_up_Tolu = v_up_max_Tolu*inhib_bio*monTolu*monSulf
   47 rate_sulf = v_up_Tolu*mSulfred
# Molar fraction of lighter isotope
   70  R = mTolu_l / mTolu		
# Save the biodegradation rate for the rate calculation of the heavier part
   82  put(rate_sulf,25)
   83  rate = rate_sulf	
# Update moles based on the calculated rates			
   90  moles = rate * R * time		                  # update lighter isotope moles based on the biodegradation rate
   91  if (moles > mTolu_l) then moles = mTolu_l      # this is to avoid negative mass
# Save moles
   200 save moles
  -end
#--------------------------------------------------------
Tolu_h # Toluene heavy
#--------------------------------------------------------
-start
# Input parameters
  4  epsilon_sulf  = parm(1)	# Isotope enrichment factor sulfate-reducing conditions	
# Get concentrations of lighter and heavier fractions + calculate total conc  	
 10  mTolu_l       = TOT("Tolu_l")           # Conc. of lighter compound
 11  mTolu_h       = TOT("Tolu_h")           # Conc. of heavier compound
 12  mTolu         = mTolu_l + mTolu_h       # total compound conc.
 13  If (mTolu  < 1e-11) THEN GOTO 200     # If the compound conc. is too low, do not calculate any rates (avoid numerical problems)
# Molar fraction of lighter isotope
 20  R = mTolu_h  / mTolu
# Calculate the biodegradation rate for heavier isotopes based on the enrichment factor (transformed here to fractionation factor)
 32  rate_sulf     = get(25) * ((epsilon_sulf/1000)+1)
 33  rate = rate_sulf
# Update moles based on the calculated rates
 40  moles   = R * rate * time   # update lighter isotope moles based on the biodegradation rate
# Save moles
 200 SAVE moles
-end
