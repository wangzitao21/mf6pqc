RATES


#-----------------------------------------------
Benznapl		# Benzene
#-----------------------------------------------
  -start
   10  mBenznapl = M
   15  if (mBenznapl <= 1e-10) then goto 200
   20  solub_Benz = 0.0227873834706977 
   22  frac_of_solub = parm(2)
   25  mBenz = tot("Benz_l") + tot("Benz_h")
   50  msolub_Benz =  frac_of_solub * solub_Benz
   60  rate = parm(1) * (msolub_Benz - mBenz)  
   65  if (mBenz > msolub_Benz) then rate = 0                                            
   70  moles = rate * time
   80  if (moles > m) then moles = m
   200 save moles
  -end
#              ------ // ------

