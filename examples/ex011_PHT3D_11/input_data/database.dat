Sulfred
    -start
   10 v_decay= parm(1) #0.1/86400 = .1157e-4
   15 c_init = parm(2) #1e-07
   20 mSulfred  = M
   30 if (mSulfred - c_init  > 0) then inhibit_fac_decay = (mSulfred - c_init)/mSulfred
   35 if (mSulfred - c_init  = 0) then inhibit_fac_decay = 0
   40 if (mSulfred - c_init  < 0) then inhibit_fac_decay = 0
   50 growth = get(24)*0.12 + get(25)*0.14 + get(26)*0.16
   60 growth = growth + get(27)*0.16 + get(28)*0.16 + get(29)*0.20
   70 growth = growth + get(30)*0.24 + get(31)*0.26
  190 decay = v_decay*mSulfred * inhibit_fac_decay
  200 moles = (decay - growth) * time
  210 if (moles > mSulfred) then moles = mSulfred
  220 SAVE moles
 -end

#--------------------------------------------------------
Sulf_l(6)
#--------------------------------------------------------
-start
# Get rate of toluene_removal 	
  1  rate_benz   = get(24) * 3.45
  2  rate_tolu   = get(25) * 4.15
  3  rate_ethy   = get(26) * 4.85
  4  rate_xyl    = get(27) * 4.85
  5  rate_oxyl   = get(28) * 4.85
  6  rate_naph   = get(29) * 5.50
  7  rate_ace    = get(30) * 6.65
  8  rate_fluo   = get(31) * 7.10
 20  mS32      = TOT("Sulf_l(6)")
 25  mS34      = TOT("Sulf_h(6)")
 26  if ((mS32+mS34) <= 1e-09) THEN GOTO 200   
 30  R         = mS32 /  (mS32+mS34)
 40  sum_rates = rate_benz + rate_tolu + rate_ethy + rate_xyl + rate_oxyl + rate_naph + rate_ace + rate_fluo 
 45  put(sum_rates,40)
 50  moles = sum_rates * R * time 
 200 SAVE moles
-end

#--------------------------------------------------------
Sulf_h(6)
#--------------------------------------------------------
-start
# Get rate of toluene_removal
 4   epsilon_s34  = parm(1)	# Isotope enrichment factor sulfate-reducing conditions	
 10  rate_sulf    = get(40)
 20  mS32         = TOT("Sulf_l(6)")
 25  mS34         = TOT("Sulf_h(6)")
 26  if ((mS32+mS34) <= 1e-10) THEN GOTO 200  
 30  R            = mS34 /  (mS32+mS34)
 35  alpha        = (epsilon_s34/1000)+1
 40  moles        = rate_sulf * R * alpha * time   # update lighter isotope moles based on the biodegradation rate
# Save moles
 200 SAVE moles
-end

