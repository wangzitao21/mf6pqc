    10 PUNCH EQUI("Calcite")
    20 PUNCH EQUI_DELTA("Calcite")
    30 PUNCH EQUI("Gypsum")
    40 PUNCH EQUI_DELTA("Gypsum")
    50 PUNCH EQUI("Ferrihydrite")
