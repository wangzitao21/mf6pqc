SURFACE 1
    # Site amount and area follow the equilibrium Goethite inventory.
    # The reference specifies 0.2 mol sites/mol mineral and 600 m2/mol.
    Hfo_w Goethite equilibrium_phase 0.2 600
    -equilibrate 0
END
COPY surface 1 2-4
END

KINETICS 1
    # Reactant amounts are mol per litre of bulk medium. RATES converts
    # water-based rates to moles using the reaction cell's water mass.
    Orgc_sed
        # PHT3D's immobile aqueous component is 0.89 mol/kgw.
        # Here it is a finite kinetic inventory: 0.89 * 0.376 = 0.33464 mol.
        -formula C 1
        -m0 0.33464
        -m 0.33464
        -parms 9.5e-10
    Calcite
        # 4 mol/kgw * 0.376 kg water; parm(1) is A/V in 1/dm.
        -m0 1.504
        -m 1.504
        -parms 100 0.6
    Pyrite
        # 0.04 mol/kgw * 0.376 kg water; parm(1) is log10(A/V).
        -m0 0.01504
        -m 0.01504
        -parms 3.42 0 0.5 0
END
COPY kinetics 1 2-4
END

USER_PUNCH 1
    -headings C_4 C_m4 Ca Cl Fe_2 Fe_3 Mg O_0 S_m2 S_6 pH pe Orgc_sed Goethite X_ex Ya_ex Yb_ex Yc_ex Yd_ex Ye_ex Yf_ex Hfo_w Calcite Pyrite HCO3
    -start
    10 PUNCH TOT("C(4)")
    20 PUNCH TOT("C(-4)")
    30 PUNCH TOT("Ca")
    40 PUNCH TOT("Cl")
    50 PUNCH TOT("Fe(2)")
    60 PUNCH TOT("Fe(3)")
    70 PUNCH TOT("Mg")
    80 PUNCH TOT("O(0)")
    90 PUNCH TOT("S(-2)")
    100 PUNCH TOT("S(6)")
    110 PUNCH -LA("H+")
    120 PUNCH -LA("e-")
    130 PUNCH KIN("Orgc_sed")
    140 PUNCH EQUI("Goethite")
    150 PUNCH TOT("X") * 0.376
    160 PUNCH TOT("Ya") * 0.376
    170 PUNCH TOT("Yb") * 0.376
    180 PUNCH TOT("Yc") * 0.376
    190 PUNCH TOT("Yd") * 0.376
    200 PUNCH TOT("Ye") * 0.376
    210 PUNCH TOT("Yf") * 0.376
    220 PUNCH TOT("Hfo_w") * 0.376
    230 PUNCH KIN("Calcite")
    240 PUNCH KIN("Pyrite")
    250 PUNCH ALK
    -end
END

SELECTED_OUTPUT 1
    -reset false
    -high_precision true
END
