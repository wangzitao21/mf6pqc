EQUILIBRIUM_PHASES 1
    # PHT3D BTN stores immobile components per representative bulk volume.
    Goethite 3.0 0.010152
END
COPY equilibrium_phases 1 2-4
END

EXCHANGE 1
    # Exchanger inventories in mol per litre of bulk medium.
    X 0.032712
    Ya 0.001316
    Yb 0.001316
    Yc 0.001316
    Yd 0.001316
    Ye 0.001316
    Yf 0.001316
    -equilibrate 0
END
EXCHANGE 2
    X 0.029704
    Ya 0.0014664
    Yb 0.0014664
    Yc 0.0014664
    Yd 0.0014664
    Ye 0.0014664
    Yf 0.0014664
    -equilibrate 0
END
EXCHANGE 3
    X 0.040608
    Ya 0.0030456
    Yb 0.0030456
    Yc 0.0030456
    Yd 0.0030456
    Ye 0.0030456
    Yf 0.0030456
