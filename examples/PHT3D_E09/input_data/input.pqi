SOLUTION 0
    units mol/L
    temp 25
    pH 7.0 charge
    pe 14.0
    O(0) 0.0002500
    N(5) 0.0003226
    Fe(2) 0.0
    S(6) 0.0001041
    Meth 0.0
    Cl 0.001
    Na 0.001
    Hycarb 0.0
END

SOLUTION 1
    units mol/L
    temp 25
    pH 7.0 charge
    pe 4.0
    O(0) 0.0
    N(5) 0.0
    Fe(2) 0.0
    S(6) 0.0
    Meth 0.0
    Cl 0.002
    Na 0.002
    Hycarb 0.0108696
END

KINETICS 1
    Oxygen_reduction
        -parms 0.1
        -m0 10.0
        -formula O2 -1.0 Hycarb -0.11111111

    Nitrate_reduction
        -parms 0.008
        -m0 10.0
        -formula NO3- -1.0 Hycarb -0.13888889

    Iron_reduction
        -parms 0.0005
        -m0 10.0
        -formula Fe+2 1.0 Hycarb -0.027777778

    Sulfate_reduction
        -parms 0.00025
        -m0 10.0
        -formula S 1.0 Hycarb -0.22222222

    Methanogenesis
        -parms 0.0001
        -m0 10.0
        -formula Meth 1.0 Hycarb -0.22222222
END

USER_PUNCH 1
    -headings Toluene Oxygen Nitrate Fe2 Sulfate Methane Chloride Sodium
    -start
    10 PUNCH TOT("Hycarb") * TOT("water") / SOLN_VOL
    20 PUNCH TOT("O(0)") * TOT("water") / SOLN_VOL
    30 PUNCH TOT("N(5)") * TOT("water") / SOLN_VOL
    40 PUNCH TOT("Fe(2)") * TOT("water") / SOLN_VOL
    50 PUNCH TOT("S(6)") * TOT("water") / SOLN_VOL
    60 PUNCH TOT("Meth") * TOT("water") / SOLN_VOL
    70 PUNCH TOT("Cl") * TOT("water") / SOLN_VOL
    80 PUNCH TOT("Na") * TOT("water") / SOLN_VOL
    -end
END

SELECTED_OUTPUT 1
    -step false
    -high_precision true
    -water false
    -solution false
    -pH false
    -simulation false
    -state false
    -time false
    -pe false
    -distance false
END

PRINT
    -warnings 0
END
