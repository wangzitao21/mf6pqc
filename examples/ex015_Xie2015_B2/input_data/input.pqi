# MIN3P 'free' means TOTAL component concentration (manual Block 14).
# Fixed pH is not adjusted for charge balance; initial B3/B4 Na is.
KNOBS
    -convergence_tolerance 1e-12
    -iterations 300
END
SOLUTION 0
    units mol/kgw
    temp 25
    pH 9.33d0
    Ca 0.000169512
    C(4) 0.0002695
    S(6) 0.000169512
    Na 0.00032
END
SOLUTION 1
    units mol/kgw
    temp 25
    pH 3.0d0
    Ca 0.0001
    C(4) 0.01
    S(6) 0.2
    Na 0.39562
END
KINETICS 1
Calcite
    -m0 8.1227382719848453
    -tol 1e-10
    -parms 4.9999999999999998e-08 2.7075794239949488e-09
Gypsum
    -m0 1.3474881543013333e-09
    -tol 1e-10
    -parms 4.9999999999999998e-08 1.3474881543013333e-09
    -cvode true
    -cvode_steps 1000
    -bad_step_max 1000
END
RATES
Calcite
    -start
10 k = PARM(1)
20 IF M > 0 THEN k = k * (M/M0)^(2/3) ELSE k = 0
30 moles = k * (1 - SR("Calcite")) * TIME
40 IF moles > 0 AND moles > M-PARM(2) THEN moles = M-PARM(2)
50 SAVE moles
    -end
Gypsum
    -start
10 k = PARM(1)
30 moles = k * (1 - SR("Gypsum")) * TIME
40 IF moles > 0 AND moles > M-PARM(2) THEN moles = M-PARM(2)
50 SAVE moles
    -end
END
USER_PUNCH 1
    -headings Calcite d_Calcite SR_Calcite SI_Calcite Gypsum d_Gypsum SR_Gypsum SI_Gypsum
    -start
10 PUNCH KIN("Calcite"), KIN_DELTA("Calcite"), SR("Calcite"), SI("Calcite")
20 PUNCH KIN("Gypsum"), KIN_DELTA("Gypsum"), SR("Gypsum"), SI("Gypsum")
    -end
END
SELECTED_OUTPUT 1
    -reset false
    -high_precision true
PRINT
    -warnings 0
END
