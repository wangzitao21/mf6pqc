SOLUTION 0
    units    mol/L
    temp     25
    pH       8.2
    pe       4.1
    Spe      0.0
END

SOLUTION 1
    units    mol/L
    temp     25
    pH       7.3
    pe       4.2
    Spe      1.0
END

KINETICS 1
    Spe
        -m0       1e10
        -formula  Spe -1
END

RATES
    Spe
    -start
    10 m_species = TOT("Spe")
    20 IF (m_species <= 1e-12) THEN GOTO 200
    30 k_mon = 0.5
    40 v_max = 4.77e-3 / 86400
    50 moles = v_max * m_species / (k_mon + m_species)
    60 moles = moles * TIME * TOT("water")
    70 available = m_species * TOT("water")
    80 IF (moles > available) THEN moles = available
    200 SAVE moles
    -end
END

SELECTED_OUTPUT 1
    -reset false
    -high_precision true

USER_PUNCH 1
    -headings Spe
    -start
    10 PUNCH TOT("Spe") * TOT("water") / SOLN_VOL
    -end
END
