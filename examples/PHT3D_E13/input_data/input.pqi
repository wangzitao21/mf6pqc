    C(-4) 0
    Ca 3.86e-4
    Cl 2.007e-2
    Fe(2) 1.0e-6
    Fe(3) 0
    Mg 1.0e-2
    O(0) 0
    S(-2) 0
    S(6) 1.0e-5
    Orgc_sed 0
END

