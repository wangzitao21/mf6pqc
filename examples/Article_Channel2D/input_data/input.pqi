TITLE Halite-saturated injection into a mixed evaporite assemblage
# Conditioning solutions are external reservoirs; their solids are not in the domain.
SOLUTION 90
    temp 25
    pH 6.818060
    units mol/L
    density 1.277848
    Cl 8.023463 charge
    K 0.444199
    Na 0.387030
    Ca 0.011049
    Mg 3.637958
    S(6) 0.051852
    C(4) 0.000088
EQUILIBRIUM_PHASES 90
    Halite 0 10
    Carnallite 0 10
    Sylvite 0 10
    Gypsum 0 10
    Polyhalite 0 10
SAVE solution 0
END
SOLUTION 91
    temp 25
    pH 7.314977
    units mol/L
    density 1.198844
    Cl 5.189443 charge
    K 0.000041
    Na 5.328907
    Ca 0.000031
    Mg 0.000515
    S(6) 0.070299
    C(4) 0.000088
EQUILIBRIUM_PHASES 91
    Halite 0 10
SAVE solution 1
END
# Finite in-domain inventory, mol per litre of representative BULK volume.
EQUILIBRIUM_PHASES 1
    Halite 0 14.760147601476
    Carnallite 0 0.92112838226828
    Sylvite 0 0.4
    Gypsum 0 0.3382949932341
    Polyhalite 0 0.18348623853211
END
SELECTED_OUTPUT 1
    -reset false
    -high_precision true
USER_PUNCH 1
    -headings Na K Mg Ca Cl S(6) C(4) Halite Carnallite Sylvite Gypsum Polyhalite d_Halite d_Carnallite d_Sylvite d_Gypsum d_Polyhalite SI_Halite SI_Carnallite SI_Sylvite SI_Gypsum SI_Polyhalite water_kg solution_L pH RHO
    -start
    10 PUNCH TOT("Na")*TOT("water")/SOLN_VOL
    20 PUNCH TOT("K")*TOT("water")/SOLN_VOL
    30 PUNCH TOT("Mg")*TOT("water")/SOLN_VOL
    40 PUNCH TOT("Ca")*TOT("water")/SOLN_VOL
    50 PUNCH TOT("Cl")*TOT("water")/SOLN_VOL
    60 PUNCH TOT("S(6)")*TOT("water")/SOLN_VOL
    70 PUNCH TOT("C(4)")*TOT("water")/SOLN_VOL
    80 PUNCH EQUI("Halite")
    90 PUNCH EQUI("Carnallite")
    100 PUNCH EQUI("Sylvite")
    110 PUNCH EQUI("Gypsum")
    120 PUNCH EQUI("Polyhalite")
    130 PUNCH EQUI_DELTA("Halite")
    140 PUNCH EQUI_DELTA("Carnallite")
    150 PUNCH EQUI_DELTA("Sylvite")
    160 PUNCH EQUI_DELTA("Gypsum")
    170 PUNCH EQUI_DELTA("Polyhalite")
    180 PUNCH SI("Halite")
    190 PUNCH SI("Carnallite")
    200 PUNCH SI("Sylvite")
    210 PUNCH SI("Gypsum")
    220 PUNCH SI("Polyhalite")
    230 PUNCH TOT("water")
    240 PUNCH SOLN_VOL
    250 PUNCH -LA("H+")
    260 PUNCH RHO
    -end
END
KNOBS
    -iterations 400
    -step_size 10
    -diagonal_scale true
    -tolerance 1e-11
END
