SOLUTION 0
    units mol/L
    temp 25
    pH 7.0 charge
    Spe 0.0
END

SOLUTION 1
    units mol/L
    temp 25
    pH 7.0 charge
    Spe 1.0
END

KINETICS 0
    Boundary_hold
        -m0 1.0
        -formula Spe 0
        -tol 1e-12
END

KINETICS 1
    Spe_decay
        -m0 1e30
        -formula Spe -1
        -tol 1e-12
END

RATES 1
    Boundary_hold
    -start
    10 SAVE 0.0
    -end

    Spe_decay
    -start
    10 concentration = TOT("Spe")
    # Steefel & MacQuarrie (1996): k = 100 yr^-1; MF6PQC time is in days.
    20 rate_constant = (100.0 / 365.25) / 86400
    30 moles = rate_constant * concentration * TIME * TOT("water")
    40 if (moles > concentration * TOT("water")) then moles = concentration * TOT("water")
    50 SAVE moles
    -end
END

USER_PUNCH 1
    -headings Spe Spe_rate_per_day
    -start
    10 concentration = TOT("Spe") * TOT("water") / SOLN_VOL
    20 PUNCH concentration, -(100.0 / 365.25) * concentration
END

SELECTED_OUTPUT 1
    -step false
    -high_precision true
    -water false
    -solution false
    -pH false
    -simulation false
    -state false
    -time false
    -pe false
    -distance false
END

PRINT
    -warnings 0
END
