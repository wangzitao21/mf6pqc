# Python caches and local environments
**/__pycache__/
**/*.py[cod]
.venv/
venv/

# Test, lint, and coverage caches
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build and packaging output
build/
dist/
*.egg-info/

# Notebook execution state
**/.ipynb_checkpoints/

# Native MODFLOW binaries are installed locally
/bin/

# Generated model workspaces and outputs
/examples/*/simulation/*
!/examples/*/simulation/.gitkeep
/examples/*/output/*
!/examples/*/output/.gitkeep
/cases/*/simulation/
/cases/*/output/

# Local case and reference collections
/cases/
/article/

# Local release verification artifacts
/.release-checks/

# Archived local cleanup artifacts
/.venv-verify/
