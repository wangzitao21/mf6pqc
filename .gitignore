# Python caches and local environments
**/__pycache__/
**/*.py[cod]
.venv/
venv/

# Test, lint, and coverage caches
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build and packaging output
build/
dist/
*.egg-info/

